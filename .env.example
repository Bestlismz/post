DATABASE_URL=postgres://rental_radar:rental_radar@localhost:5432/rental_radar
# Compose requires a strong password and a URL-encoded password in its internal URL.
POSTGRES_PASSWORD=
COMPOSE_DATABASE_URL=postgres://rental_radar:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/rental_radar
WEB_PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=
# One-time CLI only: ADMIN_EMAIL, ADMIN_PASSWORD (12+ characters), ADMIN_DISPLAY_NAME.
# Run npm run create:admin after migrations, then unset these variables.
NODE_ENV=development
# TEST_DATABASE_URL must permit creating isolated test schemas.
TEST_DATABASE_URL=

# Run migrations, then import before creating the first admin:
# npm run import:legacy -- /path/to/poc-state.json --dry-run
# npm run import:legacy -- /path/to/poc-state.json
# The import archives business state only; future channel migrations consume it.
# Development fixture entrypoint only:
POC_MODE=fixture
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
POC_LIVE_SUBMISSION=false
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0

