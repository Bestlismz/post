DATABASE_URL=postgres://rental_radar_web:REPLACE_WITH_URL_ENCODED_RUNTIME_PASSWORD@localhost:5432/rental_radar
# Owner credentials are passed only to explicit maintenance containers.
POSTGRES_PASSWORD=
MIGRATION_DATABASE_URL=postgres://rental_radar:REPLACE_WITH_URL_ENCODED_OWNER_PASSWORD@postgres:5432/rental_radar
# Use a different password of at least 16 characters for the application role.
RUNTIME_DATABASE_PASSWORD=
RUNTIME_DATABASE_URL=postgres://rental_radar_web:REPLACE_WITH_URL_ENCODED_RUNTIME_PASSWORD@postgres:5432/rental_radar
WEB_PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=
# One-time CLI only: ADMIN_EMAIL, ADMIN_PASSWORD (12+ characters), ADMIN_DISPLAY_NAME.
# Run npm run create:admin after migrations, then unset these variables.
NODE_ENV=development
# TEST_DATABASE_URL must permit creating isolated test schemas.
TEST_DATABASE_URL=

# Run migrations, then import before creating the first admin:
# npm run import:legacy -- /path/to/poc-state.json --dry-run
# npm run import:legacy -- /path/to/poc-state.json
# The import archives business state only; future channel migrations consume it.
# Development fixture entrypoint only:
POC_MODE=fixture
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
POC_LIVE_SUBMISSION=false
# Official Messenger ingress requires an explicit organization and Page binding.
META_ORGANIZATION_ID=org_default
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
# Official Page OAuth; redirect to a same-origin frontend callback that POSTs
# code/state with the session CSRF token to /api/meta/connection/callback.
META_APP_ID=
META_REDIRECT_URI=http://localhost:3000/settings/meta/callback
# JSON object of key-version -> base64-encoded 32-byte AES keys. Keep old keys
# during rotation; new connections use META_TOKEN_KEY_VERSION. Never commit keys.
META_TOKEN_KEY_VERSION=
META_TOKEN_KEYS={}
# Optional known expiry for the environment-only Page token fallback.
META_TOKEN_EXPIRES_AT=

