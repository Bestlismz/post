# Optional first-start overrides. If omitted, Compose generates persistent random
# database, session, encryption, and command secrets in private named volumes.
POSTGRES_PASSWORD=
RUNTIME_DATABASE_PASSWORD=
WORKER_DATABASE_PASSWORD=
WEB_PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=
ADMIN_EMAIL=admin@naina.local
ADMIN_PASSWORD=admin123456
ADMIN_DISPLAY_NAME=Naina Admin
BOOTSTRAP_SAMPLE_DATA=true
NODE_ENV=development
# TEST_DATABASE_URL must permit creating isolated test schemas.
TEST_DATABASE_URL=

# Advanced legacy imports must run before the automatic first bootstrap. See README.
# Development fixture entrypoint only:
POC_MODE=fixture
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
POC_LIVE_SUBMISSION=false
# Official Messenger ingress requires an explicit organization and Page binding.
META_ORGANIZATION_ID=org_default
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
# Frontend Cutover dependency: implement this same-origin callback page. It POSTs
# code/state with the session CSRF token to /api/meta/connection/callback.
META_APP_ID=
META_REDIRECT_URI=http://localhost:3000/settings/meta/callback
# JSON object of key-version -> base64-encoded 32-byte AES keys. Keep old keys
# during rotation; new connections use META_TOKEN_KEY_VERSION. Never commit keys.
META_TOKEN_KEY_VERSION=
META_TOKEN_KEYS={}
# Shared HMAC command keys for the application scan dispatcher and isolated
# Group browser worker. JSON values are base64-encoded exact 32-byte keys. Keep old
# keys during rotation and select the active key with GROUP_COMMAND_KEY_ID.
GROUP_COMMAND_KEY_ID=
GROUP_COMMAND_KEYS={}
# Comma-separated numeric Facebook Group IDs allowed for reply/edit/reconciliation.
# Signed scans and session recovery for groups added through Sources do not need
# this list. Sending also requires STAGING_FACEBOOK_SOURCE_ALLOWLIST.
GROUP_SOURCE_ALLOWLIST=
GROUP_SUPPORTED_SELECTOR_VERSIONS=facebook-dom-v3
GROUP_SCHEDULER_POLL_MS=15000
# Temporary demo override. Leave blank in production; 10000 means one scan slot every 10 seconds.
GROUP_SCHEDULER_TEST_CADENCE_MS=
GROUP_SCHEDULER_BATCH_SIZE=50
GROUP_SCHEDULER_TICK_TIMEOUT_MS=30000
# Internal Compose endpoints. Do not publish the worker or noVNC ports.
GROUP_WORKER_URL=http://group-worker:3001
GROUP_RECOVERY_PROXY_URL=http://group-worker:6081
GROUP_OPERATION_LEDGER_PATH=/data/group-operations
# Staging sends require both values. Keep false/empty outside an authorized test.
STAGING_FACEBOOK_SEND=false
STAGING_FACEBOOK_SOURCE_ALLOWLIST=
# Optional known expiry for the environment-only Page token fallback.
META_TOKEN_EXPIRES_AT=

